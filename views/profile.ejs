<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>BlogSpace | Profile</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        dark: "#09090f",
                        panel: "#11111b",
                        accent: "#8b5cf6"
                    }
                }
            }
        };
    </script>

    <style>
        body {
            background:
                radial-gradient(circle at 15% 0%, #21163c 0, transparent 30%),
                #09090f;
        }

        .glass {
            background: rgba(17, 17, 27, 0.88);
            border: 1px solid rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(16px);
        }

        .input-dark {
            background: #0b0b13;
            border: 1px solid #292938;
            color: #f3f4f6;
            transition: 0.2s;
        }

        .input-dark:focus {
            border-color: #8b5cf6;
            outline: none;
            box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.12);
        }

        .post-card {
            transition: border-color 0.2s, transform 0.2s;
        }

        .post-card:hover {
            border-color: rgba(139, 92, 246, 0.4);
            transform: translateY(-2px);
        }

        .gradient-text {
            background: linear-gradient(90deg, #c4b5fd, #818cf8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
    </style>
</head>

<body class="min-h-screen text-gray-200">

    <!-- Navbar -->
    <nav class="sticky top-0 z-20 border-b border-white/10 bg-[#09090f]/90 backdrop-blur-xl">
        <div class="max-w-6xl mx-auto px-5 py-4 flex justify-between items-center">

            <a href="/" class="flex items-center gap-3">
                <div
                    class="w-10 h-10 rounded-xl bg-violet-600 flex items-center justify-center shadow-lg shadow-violet-900/30">
                    <i class="fa-solid fa-feather-pointed text-white text-lg"></i>
                </div>

                <span class="text-xl font-bold tracking-tight">
                    Blog<span class="gradient-text">Space</span>
                </span>
            </a>

            <div class="flex items-center gap-3">
                <span class="hidden sm:block text-sm text-gray-400">
                    My profile
                </span>

                <a href="/logout"
                    class="flex items-center gap-2 px-4 py-2 rounded-xl border border-red-500/20 bg-red-500/10 text-red-400 hover:bg-red-500/20 transition">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    <span class="text-sm font-medium">Logout</span>
                </a>
            </div>

        </div>
    </nav>


    <main class="max-w-6xl mx-auto px-5 py-10">

        <!-- Welcome -->
        <div class="mb-8">
            <p class="text-violet-400 text-sm font-semibold tracking-widest uppercase mb-2">
                Your personal space
            </p>

            <h1 class="text-3xl sm:text-4xl font-bold text-white">
                Welcome back, <span class="gradient-text">
                    <%= user.name %>
                </span>
            </h1>

            <p class="text-gray-400 mt-2">
                Share your thoughts. Create something worth reading.
            </p>
        </div>


        <!-- Profile Card -->
        <section class="glass rounded-3xl p-6 sm:p-8 mb-8 relative overflow-hidden">

            <div class="absolute -right-16 -top-20 w-64 h-64 bg-violet-600/10 rounded-full blur-3xl"></div>

            <div class="relative flex flex-col sm:flex-row items-center sm:items-start gap-6">

                <div
                    class="w-24 h-24 rounded-2xl bg-gradient-to-br from-violet-500 to-indigo-600 flex items-center justify-center text-4xl text-white shadow-xl shadow-violet-900/30">
                    <i class="fa-solid fa-user-astronaut"></i>
                </div>

                <div class="flex-1 text-center sm:text-left">
                    <h2 class="text-2xl font-bold text-white">
                        <%= user.name %>
                    </h2>

                    <p class="text-violet-300 mt-1">
                        @<%= user.username %>
                    </p>

                    <p class="text-gray-400 mt-3 break-all">
                        <i class="fa-regular fa-envelope mr-2"></i>
                        <%= user.email %>
                    </p>

                    <div class="flex flex-wrap justify-center sm:justify-start gap-3 mt-5">

                        <div class="bg-white/5 border border-white/5 rounded-xl px-4 py-3 min-w-24">
                            <p class="text-2xl font-bold text-white">
                                <%= user.posts ? user.posts.length : 0 %>
                            </p>
                            <p class="text-xs text-gray-400 mt-1">Posts</p>
                        </div>

                        <div class="bg-white/5 border border-white/5 rounded-xl px-4 py-3">
                            <p class="text-sm font-semibold text-emerald-400">
                                <i class="fa-solid fa-circle-check mr-1"></i>
                                Active
                            </p>
                            <p class="text-xs text-gray-400 mt-1">Account status</p>
                        </div>

                    </div>
                </div>

            </div>
        </section>


        <!-- Create Post -->
        <section class="glass rounded-3xl p-6 sm:p-8 mb-10">

            <div class="flex items-center gap-3 mb-6">
                <div class="w-11 h-11 rounded-xl bg-violet-500/15 text-violet-400 flex items-center justify-center">
                    <i class="fa-solid fa-pen-to-square text-lg"></i>
                </div>

                <div>
                    <h2 class="text-xl font-bold text-white">Create a post</h2>
                    <p class="text-sm text-gray-400">Put your ideas into words.</p>
                </div>
            </div>

            <form action="/submit" method="POST">

                <div class="mb-5">
                    <label for="title" class="block text-sm font-medium text-gray-300 mb-2">
                        Post title
                    </label>

                    <input id="title" type="text" name="title" placeholder="Give your post a catchy title..."
                        maxlength="150" required class="input-dark w-full rounded-xl px-4 py-3.5">
                </div>

                <div class="mb-5">
                    <label for="content" class="block text-sm font-medium text-gray-300 mb-2">
                        Your content
                    </label>

                    <textarea id="content" name="content" rows="5" placeholder="What's on your mind today?" required
                        class="input-dark w-full rounded-xl px-4 py-3.5 resize-y"></textarea>
                </div>

                <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4">

                    <p class="text-xs text-gray-500">
                        <i class="fa-solid fa-lightbulb text-amber-400 mr-1"></i>
                        Write something meaningful.
                    </p>

                    <button type="submit"
                        class="inline-flex justify-center items-center gap-2 rounded-xl bg-violet-600 hover:bg-violet-500 px-6 py-3 font-semibold text-white shadow-lg shadow-violet-900/20 transition">
                        <i class="fa-solid fa-paper-plane"></i>
                        Publish post
                    </button>

                </div>

            </form>
        </section>


        <!-- Posts Heading -->
        <section>

            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-end gap-3 mb-6">

                <div>
                    <p class="text-xs text-violet-400 uppercase tracking-widest font-semibold mb-2">
                        Your content
                    </p>

                    <h2 class="text-2xl font-bold text-white">
                        My posts
                    </h2>
                </div>

                <span
                    class="self-start sm:self-auto rounded-full border border-violet-500/20 bg-violet-500/10 px-4 py-2 text-sm text-violet-300">
                    <i class="fa-regular fa-file-lines mr-2"></i>
                    <%= user.posts ? user.posts.length : 0 %> total
                </span>

            </div>


            <!-- Posts List -->
            <% if (user.posts && user.posts.length> 0) { %>

                <% user.posts.forEach(function(post) { %>

                    <article class="post-card glass rounded-2xl p-6 mb-5">

                        <!-- Post Header -->
                        <div class="flex justify-between items-start gap-3 mb-5">

                            <div class="flex items-center gap-3">
                                <div
                                    class="w-11 h-11 rounded-xl bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center text-white">
                                    <i class="fa-solid fa-user"></i>
                                </div>

                                <div>
                                    <h3 class="font-semibold text-white">
                                        <%= user.name %>
                                    </h3>

                                    <p class="text-sm text-gray-500">
                                        @<%= user.username %>
                                    </p>
                                </div>
                            </div>

                            <span class="text-xs text-emerald-400 bg-emerald-400/10 px-3 py-1.5 rounded-full">
                                <i class="fa-solid fa-earth-asia mr-1"></i>
                                My post
                            </span>

                        </div>


                        <!-- Post Body -->
                        <div class="mb-6">
                            <h4 class="text-xl sm:text-2xl font-bold text-white mb-3 break-words">
                                <%= post.posttitle %>
                            </h4>

                            <p class="text-gray-300 leading-7 whitespace-pre-wrap break-words">
                                <%= post.postdata %>
                            </p>
                        </div>


                        <!-- Post Actions -->
                        <div class="flex flex-wrap items-center gap-3 border-t border-white/10 pt-5">

                            <form action="/like/<%= post._id %>" method="POST">
                                <button type="submit"
                                    class="flex items-center gap-2 rounded-xl border border-violet-500/20 bg-violet-500/10 px-4 py-2.5 text-sm font-medium text-violet-300 hover:bg-violet-500/20 transition">
                                    <i class="fa-solid fa-heart"></i>
                                    <%= post.likes.indexOf(user_id)==-1?"like":"UnLike"%>
                                    <span class="bg-violet-500/20 px-2 py-0.5 rounded-md">
                                        <%= post.likes ? post.likes.length : 0 %>
                                    </span>
                                </button>
                            </form>

                            <a href="/edit/<%= post._id %>"
                                class="flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-medium text-gray-300 hover:bg-white/10 transition">
                                <i class="fa-solid fa-pen"></i>
                                Edit post
                            </a>

                        </div>

                    </article>

                    <% }) %>

                        <% } else { %>

                            <!-- Empty State -->
                            <div class="glass rounded-3xl px-6 py-16 text-center">

                                <div
                                    class="mx-auto mb-5 w-20 h-20 rounded-2xl bg-violet-500/10 flex items-center justify-center text-violet-400 text-3xl">
                                    <i class="fa-regular fa-folder-open"></i>
                                </div>

                                <h3 class="text-xl font-bold text-white mb-2">
                                    Your story starts here
                                </h3>

                                <p class="text-gray-400 max-w-sm mx-auto leading-6">
                                    You haven't published anything yet. Create your first post and it will appear here.
                                </p>

                            </div>

                            <% } %>

        </section>

        <!-- Footer -->
        <footer class="text-center text-xs text-gray-600 py-10">
            Made for your ideas · BlogSpace
        </footer>

    </main>

</body>

</html>