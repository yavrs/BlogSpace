<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>BlogSpace | Share Your Story</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        body {
            background:
                radial-gradient(circle at 15% 10%, #241644 0, transparent 35%),
                radial-gradient(circle at 85% 45%, #171d43 0, transparent 30%),
                #09090f;
        }

        .glass {
            background: rgba(255, 255, 255, 0.035);
            border: 1px solid rgba(255, 255, 255, 0.09);
            backdrop-filter: blur(15px);
        }

        .gradient-text {
            background: linear-gradient(90deg, #c4b5fd, #818cf8, #67e8f9);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero-glow {
            box-shadow: 0 0 80px rgba(139, 92, 246, 0.12);
        }

        .feature-card {
            transition: transform 0.25s ease, border-color 0.25s ease;
        }

        .feature-card:hover {
            transform: translateY(-6px);
            border-color: rgba(139, 92, 246, 0.45);
        }
    </style>
</head>

<body class="min-h-screen text-gray-200">

    <!-- Navbar -->
    <nav class="sticky top-0 z-50 border-b border-white/10 bg-[#09090f]/85 backdrop-blur-xl">
        <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">

            <a href="/" class="flex items-center gap-3">
                <div
                    class="w-10 h-10 rounded-xl bg-violet-600 flex items-center justify-center shadow-lg shadow-violet-900/30">
                    <i class="fa-solid fa-feather-pointed text-white text-lg"></i>
                </div>

                <span class="text-xl font-bold tracking-tight text-white">
                    Blog<span class="gradient-text">Space</span>
                </span>
            </a>

            <div class="flex items-center gap-3">

                <a href="/login" class="px-4 py-2 text-sm font-medium text-gray-300 hover:text-white transition">
                    Login
                </a>

                <a href="/register"
                    class="px-5 py-2.5 rounded-xl bg-violet-600 hover:bg-violet-500 text-white text-sm font-semibold transition shadow-lg shadow-violet-900/20">
                    Get Started
                    <i class="fa-solid fa-arrow-right ml-2"></i>
                </a>

            </div>

        </div>
    </nav>


    <!-- Hero Section -->
    <main>

        <section class="max-w-7xl mx-auto px-6 pt-20 pb-20 lg:pt-28 lg:pb-28">

            <div class="grid lg:grid-cols-2 gap-14 items-center">

                <!-- Left Content -->
                <div>

                    <div
                        class="inline-flex items-center gap-2 rounded-full border border-violet-500/25 bg-violet-500/10 px-4 py-2 mb-7">
                        <span class="w-2 h-2 rounded-full bg-violet-400"></span>

                        <span class="text-sm text-violet-300">
                            Your thoughts deserve a space
                        </span>
                    </div>

                    <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold tracking-tight leading-tight text-white">
                        Every thought
                        <br>

                        deserves to be
                        <br>

                        <span class="gradient-text">shared.</span>
                    </h1>

                    <p class="mt-7 text-lg text-gray-400 leading-8 max-w-xl">
                        Welcome to BlogSpace — a place to express your ideas,
                        share your experiences, and turn your thoughts into
                        stories worth reading.
                    </p>

                    <div class="flex flex-wrap gap-4 mt-9">

                        <a href="/register"
                            class="inline-flex items-center gap-3 rounded-xl bg-violet-600 hover:bg-violet-500 px-7 py-4 text-white font-semibold transition shadow-xl shadow-violet-900/25">
                            Start Writing
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>

                        <a href="/login"
                            class="inline-flex items-center gap-3 rounded-xl border border-white/10 bg-white/5 hover:bg-white/10 px-7 py-4 text-gray-200 font-semibold transition">
                            <i class="fa-solid fa-right-to-bracket"></i>
                            Login
                        </a>

                    </div>

                    <div class="flex items-center gap-4 mt-10 text-sm text-gray-500">
                        <i class="fa-solid fa-pen-nib text-violet-400"></i>
                        <span>Your voice. Your ideas. Your space.</span>
                    </div>

                </div>


                <!-- Right Hero Card -->
                <div class="relative">

                    <div class="absolute inset-0 bg-violet-600/10 blur-3xl rounded-full"></div>

                    <div class="glass hero-glow relative rounded-3xl p-6 sm:p-8 rotate-1">

                        <div class="flex justify-between items-center mb-8">

                            <div class="flex items-center gap-3">
                                <div
                                    class="w-11 h-11 rounded-xl bg-gradient-to-br from-violet-500 to-indigo-600 flex items-center justify-center">
                                    <i class="fa-solid fa-feather-pointed text-white"></i>
                                </div>

                                <div>
                                    <p class="font-semibold text-white">The Writing Space</p>
                                    <p class="text-xs text-gray-500 mt-1">A place for your ideas</p>
                                </div>
                            </div>

                            <span class="text-violet-300 text-sm">
                                <i class="fa-solid fa-sparkles"></i>
                            </span>

                        </div>


                        <div class="rounded-2xl bg-[#0b0b13] border border-white/10 p-6">

                            <div class="flex gap-2 mb-6">
                                <span class="w-3 h-3 rounded-full bg-red-400"></span>
                                <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
                                <span class="w-3 h-3 rounded-full bg-green-400"></span>
                            </div>

                            <p class="text-xs uppercase tracking-widest text-violet-400 font-semibold mb-4">
                                A new beginning
                            </p>

                            <h2 class="text-2xl sm:text-3xl font-bold text-white leading-snug">
                                "Your next great idea starts with a single sentence."
                            </h2>

                            <p class="text-gray-400 mt-5 leading-7">
                                Write what inspires you. Share what you learn.
                                Create something that matters.
                            </p>

                            <div class="border-t border-white/10 mt-7 pt-5 flex justify-between items-center">

                                <div class="flex items-center gap-2 text-sm text-gray-400">
                                    <i class="fa-regular fa-pen-to-square text-violet-400"></i>
                                    Ready to write?
                                </div>

                                <a href="/register"
                                    class="text-violet-300 hover:text-white font-semibold text-sm transition">
                                    Let's begin
                                    <i class="fa-solid fa-arrow-right ml-1"></i>
                                </a>

                            </div>

                        </div>

                        <div class="grid grid-cols-2 gap-4 mt-5">

                            <div class="rounded-2xl bg-violet-500/10 border border-violet-500/15 p-4">
                                <i class="fa-solid fa-lightbulb text-violet-400 text-xl"></i>
                                <p class="font-semibold text-white mt-3">Your Ideas</p>
                                <p class="text-xs text-gray-400 mt-1">Express yourself freely</p>
                            </div>

                            <div class="rounded-2xl bg-indigo-500/10 border border-indigo-500/15 p-4">
                                <i class="fa-solid fa-heart text-indigo-400 text-xl"></i>
                                <p class="font-semibold text-white mt-3">Your Stories</p>
                                <p class="text-xs text-gray-400 mt-1">Make every word count</p>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- Community Posts Section -->
        <section id="community-posts" class="border-t border-white/10 bg-white/[0.015]">

            <div class="max-w-7xl mx-auto px-6 py-20">

                <!-- Section Heading -->
                <div class="flex flex-col sm:flex-row sm:items-end
                    justify-between gap-5 mb-10">

                    <div>
                        <p class="text-sm text-violet-400 uppercase
                          tracking-widest font-semibold mb-3">
                            The Community
                        </p>

                        <h2 class="text-3xl sm:text-4xl font-bold text-white">
                            Stories worth <span class="gradient-text">reading.</span>
                        </h2>

                        <p class="text-gray-400 mt-4 leading-7">
                            Discover ideas, experiences and stories shared
                            by our community.
                        </p>
                    </div>

                    <a href="/register" class="inline-flex items-center justify-center gap-2
                       rounded-xl bg-violet-600 hover:bg-violet-500
                       px-5 py-3 text-sm font-semibold text-white
                       transition shrink-0">
                        <i class="fa-solid fa-pen"></i>
                        Write a Post
                    </a>

                </div>

                <!-- Posts Grid -->
                <% if (posts && posts.length> 0) { %>

                    <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-6">

                        <% posts.forEach(function(post) { %>

                            <article class="feature-card glass rounded-2xl p-6
                               flex flex-col min-w-0">

                                <!-- Author -->
                                <div class="flex items-center gap-3 mb-6">

                                    <div class="w-11 h-11 rounded-full
                                        bg-gradient-to-br from-violet-500
                                        to-indigo-600 flex items-center
                                        justify-center font-bold text-white
                                        text-lg shrink-0">
                                        <%= post.user && post.user.username ? post.user.username.charAt(0).toUpperCase()
                                            : "U" %>
                                    </div>

                                    <div class="min-w-0">
                                        <p class="text-sm font-semibold text-white
                                          truncate">
                                            <%= post.user ? (post.user.username || post.user.name || "User" )
                                                : "Unknown User" %>
                                        </p>

                                        <p class="text-xs text-gray-500 mt-1">
                                            Community author
                                        </p>
                                    </div>

                                    <div class="ml-auto text-violet-400">
                                        <i class="fa-regular fa-file-lines text-lg"></i>
                                    </div>

                                </div>

                                <!-- Post Title -->
                                <h3 class="text-xl font-bold text-white
                                   leading-snug mb-3 break-words">
                                    <%= post.posttitle %>
                                </h3>

                                <!-- Post Content -->
                                <p class="text-gray-400 leading-7 text-sm
                                  whitespace-pre-wrap break-words
                                  mb-7">
                                    <%= post.postdata %>
                                </p>

                                <!-- Like Button -->
                                <div class="mt-auto pt-5 border-t border-white/10
                                    flex items-center justify-between">

                                    <span class="text-xs text-gray-500">
                                        <i class="fa-solid fa-feather-pointed
                                          text-violet-400 mr-1"></i>
                                        Shared on BlogSpace
                                    </span>

                                    

                                   


                                </div>

                            </article>

                            <% }) %>

                    </div>

                    <% } else { %>

                        <!-- Empty State -->
                        <div class="glass rounded-3xl px-6 py-16 text-center">

                            <div class="w-16 h-16 mx-auto rounded-2xl
                            bg-violet-500/10 border border-violet-500/20
                            flex items-center justify-center
                            text-violet-400 text-2xl mb-6">
                                <i class="fa-solid fa-feather-pointed"></i>
                            </div>

                            <h3 class="text-xl font-bold text-white mb-3">
                                No stories yet
                            </h3>

                            <p class="text-gray-400 max-w-md mx-auto leading-7">
                                Be the first to share your thoughts and inspire
                                the BlogSpace community.
                            </p>

                            <a href="/register" class="inline-flex items-center gap-2 mt-6
                           rounded-xl bg-violet-600 hover:bg-violet-500
                           px-6 py-3 font-semibold text-white transition">
                                Create Your First Post
                                <i class="fa-solid fa-arrow-right"></i>
                            </a>

                        </div>

                        <% } %>

            </div>
        </section>




        <!-- Features Section -->
        <section class="border-t border-white/10 bg-white/[0.015]">

            <div class="max-w-7xl mx-auto px-6 py-20">

                <div class="text-center max-w-2xl mx-auto mb-14">

                    <p class="text-sm text-violet-400 uppercase tracking-widest font-semibold mb-3">
                        Why BlogSpace?
                    </p>

                    <h2 class="text-3xl sm:text-4xl font-bold text-white">
                        Everything starts with an idea.
                    </h2>

                    <p class="text-gray-400 mt-4 leading-7">
                        A simple space to create posts, share your perspective,
                        and keep all your writing in one place.
                    </p>

                </div>


                <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">

                    <!-- Feature 1 -->
                    <div class="feature-card glass rounded-2xl p-7">

                        <div
                            class="w-12 h-12 rounded-xl bg-violet-500/15 flex items-center justify-center text-violet-400 text-xl">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </div>

                        <h3 class="text-xl font-bold text-white mt-6">
                            Create Posts
                        </h3>

                        <p class="text-gray-400 mt-3 leading-7">
                            Turn your thoughts into posts with a simple,
                            distraction-free writing experience.
                        </p>

                    </div>


                    <!-- Feature 2 -->
                    <div class="feature-card glass rounded-2xl p-7">

                        <div
                            class="w-12 h-12 rounded-xl bg-indigo-500/15 flex items-center justify-center text-indigo-400 text-xl">
                            <i class="fa-solid fa-heart"></i>
                        </div>

                        <h3 class="text-xl font-bold text-white mt-6">
                            Like & Engage
                        </h3>

                        <p class="text-gray-400 mt-3 leading-7">
                            Show appreciation for posts you enjoy and make
                            your reading experience more engaging.
                        </p>

                    </div>


                    <!-- Feature 3 -->
                    <div class="feature-card glass rounded-2xl p-7">

                        <div
                            class="w-12 h-12 rounded-xl bg-cyan-500/15 flex items-center justify-center text-cyan-400 text-xl">
                            <i class="fa-solid fa-user-shield"></i>
                        </div>

                        <h3 class="text-xl font-bold text-white mt-6">
                            Your Own Profile
                        </h3>

                        <p class="text-gray-400 mt-3 leading-7">
                            Manage your account, view your published posts,
                            and keep your writing organized.
                        </p>

                    </div>

                </div>

            </div>

        </section>


        <!-- CTA Section -->
        <section class="max-w-7xl mx-auto px-6 py-20">

            <div
                class="relative overflow-hidden rounded-3xl border border-violet-500/20 bg-gradient-to-br from-violet-950/70 via-[#151327] to-indigo-950/50 p-8 sm:p-14 text-center">

                <div class="absolute -top-20 left-1/3 w-64 h-64 bg-violet-500/10 blur-3xl rounded-full"></div>

                <div class="relative">

                    <div
                        class="w-14 h-14 rounded-2xl bg-violet-500/20 flex items-center justify-center mx-auto text-violet-300 text-2xl">
                        <i class="fa-solid fa-feather-pointed"></i>
                    </div>

                    <h2 class="text-3xl sm:text-4xl font-bold text-white mt-6">
                        Ready to share your story?
                    </h2>

                    <p class="text-gray-400 mt-4 max-w-xl mx-auto leading-7">
                        Create your account and start turning your thoughts
                        into something meaningful.
                    </p>

                    <a href="/register"
                        class="inline-flex items-center gap-3 mt-8 rounded-xl bg-violet-600 hover:bg-violet-500 px-7 py-4 font-semibold text-white transition shadow-lg shadow-violet-900/20">
                        Create Your Account
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>

                </div>

            </div>

        </section>

    </main>


    <!-- Footer -->
    <footer class="border-t border-white/10">

        <div class="max-w-7xl mx-auto px-6 py-7 flex flex-col sm:flex-row justify-between items-center gap-4">

            <a href="/" class="font-bold text-white text-lg">
                Blog<span class="gradient-text">Space</span>
            </a>

            <p class="text-sm text-gray-500">
                A little space for big ideas.
            </p>

            <p class="text-xs text-gray-600">
                &copy; <span id="year"></span> BlogSpace
            </p>

        </div>

    </footer>

    <script>
        document.getElementById("year").textContent =
            new Date().getFullYear();
    </script>

</body>

</html>