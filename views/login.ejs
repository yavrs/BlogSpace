
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Profile | UserSpace</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen bg-gray-950 text-white flex items-center justify-center p-5">

    <div class="w-full max-w-md">

        <!-- Top Navigation -->
        <div class="flex items-center justify-between mb-6">
            <a href="/" class="text-xl font-bold tracking-tight">
                <span class="text-indigo-500">Blog</span>Space
            </a>

            <a href="/register"
                class="text-sm font-semibold text-gray-300 hover:text-indigo-400 transition">
                New User? Register here →
            </a>
        </div>

        <!-- Form Card -->
        <div class="bg-gray-900 border border-gray-800 rounded-2xl p-6 sm:p-8 shadow-2xl">

            <!-- Heading -->
            <div class="mb-8">
               

                <h1 class="text-3xl font-bold tracking-tight">
                    Create Profile
                </h1>

                <p class="text-gray-400 mt-2 text-sm">
                    Add a new user to your dashboard.
                </p>
            </div>

            <!-- Form -->
            <form action="/Login" method="POST" class="space-y-5">

             

                <!-- Email -->
                <div>
                    <label for="email"
                        class="block text-sm font-medium text-gray-300 mb-2">
                        Email Address
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="you@example.com"
                        autocomplete="email"
                        class="w-full bg-gray-950 text-white border border-gray-700 rounded-xl px-4 py-3 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 placeholder:text-gray-600"
                        required
                    >
                </div>

                <!-- Password -->
                <div>
                    <label for="password"
                        class="block text-sm font-medium text-gray-300 mb-2">
                        Password
                    </label>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Create a strong password"
                        minlength="8"
                        autocomplete="new-password"
                        class="w-full bg-gray-950 text-white border border-gray-700 rounded-xl px-4 py-3 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 placeholder:text-gray-600"
                        required
                    >

                    <p class="text-xs text-gray-500 mt-2">
                        Password must be at least 8 characters long.
                    </p>
                </div>

                <!-- Submit Button -->
                <button
                    type="submit"
                    class="w-full bg-indigo-600 hover:bg-indigo-500 active:scale-[0.98] text-white font-semibold py-3 rounded-xl transition duration-200 shadow-lg shadow-indigo-950/30 cursor-pointer"
                >
                    Login User →
                </button>

            </form>

            <!-- Footer -->
            <p class="text-center text-xs text-gray-500 mt-6">
                Your details will be saved securely.
            </p>

        </div>

        <p class="text-center text-xs text-gray-600 mt-6">
            UserSpace · User Management
        </p>

    </div>

</body>
</html>
